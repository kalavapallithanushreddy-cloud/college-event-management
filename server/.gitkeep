:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #1e293b;
  background: #eef4ff;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(135deg, #edf6ff 0%, #eef2ff 100%);
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1400px;
  margin: 0 auto;
  padding: 32px 20px 60px;
}

.topbar {
  margin-bottom: 28px;
}

.topbar h1 {
  margin: 8px 0 0;
  font-size: clamp(2rem, 3vw, 3rem);
  color: #0f172a;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.75rem;
  color: #4f46e5;
  font-weight: 700;
}

.layout {
  display: grid;
  grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);
  gap: 24px;
}

.panel {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 22px;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  padding: 24px;
}

.panel h2 {
  margin-top: 0;
  margin-bottom: 20px;
  color: #0f172a;
}

.event-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.field-row,
.field-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #334155;
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  background: #fff;
  color: #0f172a;
  padding: 12px 14px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input:focus,
textarea:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
}

textarea {
  resize: vertical;
  min-height: 110px;
}

.button-row {
  display: flex;
  gap: 12px;
  margin-top: 4px;
}

.primary-btn,
.secondary-btn,
.edit-btn,
.delete-btn {
  border: none;
  border-radius: 12px;
  padding: 11px 18px;
  font-weight: 700;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.primary-btn:hover,
.secondary-btn:hover,
.edit-btn:hover,
.delete-btn:hover {
  transform: translateY(-1px);
}

.primary-btn {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  color: #fff;
}

.secondary-btn {
  background: #e2e8f0;
  color: #1e293b;
}

.event-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.event-card {
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 18px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.card-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.event-date {
  margin: 0 0 6px;
  color: #4f46e5;
  font-weight: 700;
  font-size: 0.85rem;
}

.event-card h3 {
  margin: 0;
  font-size: 1.25rem;
  color: #0f172a;
}

.tag {
  background: #dbeafe;
  color: #1d4ed8;
  border-radius: 999px;
  font-weight: 700;
  padding: 6px 10px;
  font-size: 0.8rem;
}

.event-card p {
  margin: 10px 0;
  color: #475569;
}

.participants-box {
  margin-top: 16px;
}

.participant-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.participant-pill {
  background: #ede9fe;
  color: #5b21b6;
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 0.8rem;
  font-weight: 700;
}

.card-actions {
  display: flex;
  gap: 10px;
  margin-top: 18px;
}

.edit-btn {
  background: #dbeafe;
  color: #1d4ed8;
}

.delete-btn {
  background: #fee2e2;
  color: #b91c1c;
}

.empty-state {
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  border-radius: 16px;
  padding: 28px;
  text-align: center;
  color: #64748b;
  font-weight: 600;
}

@media (max-width: 900px) {
  .layout {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .field-grid {
    grid-template-columns: 1fr;
  }

  .button-row,
  .card-actions {
    flex-direction: column;
  }
}
